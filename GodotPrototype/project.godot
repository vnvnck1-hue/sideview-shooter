; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sideview Workshop Prototype"
config/version="0.1.0"
run/main_scene="res://scenes/Lobby.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon/icon.png"
config/windows_native_icon="res://icon/icon.ico"

[autoload]

ViewFit="*res://scripts/view_fit.gd"
CrtFx="*res://scripts/crt_overlay.gd"
Audio="*res://scripts/audio_manager.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="fractional"

[dotnet]

project/assembly_name="Sideview Workshop Prototype"

[rendering]

textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0, 0, 0, 1)

[shader_globals]

light_range_mul={
"type": "float",
"value": 1.0
}
backlight_body={
"type": "float",
"value": 0.3
}
backlight_dip={
"type": "float",
"value": 0.3
}
backlight_rim={
"type": "float",
"value": 1.8
}
dv_on={
"type": "float",
"value": 0.0
}
dv_origin={
"type": "vec2",
"value": Vector2(0, 0)
}
dv_axis_x={
"type": "vec2",
"value": Vector2(1, 0)
}
dv_axis_y={
"type": "vec2",
"value": Vector2(0, 1)
}
dv_eye={
"type": "vec2",
"value": Vector2(0, 0)
}
dv_clear={
"type": "float",
"value": 800.0
}
dv_dark={
"type": "float",
"value": 1700.0
}
dv_shadow_edge={
"type": "color",
"value": Color(0.187, 0.077, 0.165, 1)
}
dv_shadow_deep={
"type": "color",
"value": Color(0.026, 0.015, 0.053, 1)
}
dv_shadow_accent={
"type": "color",
"value": Color(0.033, 0.11, 0.143, 1)
}
